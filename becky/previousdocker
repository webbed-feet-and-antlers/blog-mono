FROM nvidia/cuda:12.6.3-devel-ubuntu22.04

ENV DEBIAN_FRONTEND=noninteractive
ENV SKIP_TORCH_VERSION_CHECK=1

RUN apt-get update && apt-get install -y --no-install-recommends \
        python3 python3-pip python3-dev \
        git cmake \
    && rm -rf /var/lib/apt/lists/*

RUN python3 -m pip install --no-cache-dir --upgrade pip setuptools wheel ninja

WORKDIR /app

# Install PyTorch first with the correct CUDA index, then everything else
RUN python3 -m pip install --no-cache-dir \
    torch==2.8.0 --index-url https://download.pytorch.org/whl/cu126

RUN python3 -m pip install --no-cache-dir \
    transformers==4.57.0 \
    bitsandbytes \
    accelerate \
    pyarrow \
    numpy \
    sentence_transformers \
    tqdm

# Flash-attn: builds from source, installs cleanly
RUN python3 -m pip install --no-cache-dir flash-attn --no-build-isolation

# Transformer Engine: needs matching CUDA (12.6) + cmake to compile
RUN python3 -m pip install --no-cache-dir transformer_engine[pytorch] --no-build-isolation

COPY embed_parquet.py /app/embed_parquet.py
COPY modules/ /app/modules/
ENTRYPOINT ["python3", "embed_parquet.py"]

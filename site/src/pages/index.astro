.58311,-26.35701c1.67767,-0.08798 -7.41846,8.73812 -6.47874,15.64114c0.95537,7.01796 12.00872,23.8991 12.13116,26.13207c0.28352,5.1706 -5.13668,14.73303 -9.66526,16.46431c-4.48964,1.71639 -13.19034,-0.07211 -14.17645,-2.69645c-1.01544,-2.7024 3.50896,-11.10659 8.84907,-13.5461c9.17568,-4.19171 37.28456,-6.65746 46.99278,-0.6182c8.19166,5.09584 12.30163,17.66605 9.36199,26.43285c-3.70085,11.03693 -24.02005,22.12838 -44.41144,27.20921c-38.47245,9.58601 -180.37827,-13.83917 -180.37827,-13.83917" />

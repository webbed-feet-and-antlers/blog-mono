        <path d="M1049.11355,297.94553c0,0 -8.90384,14.67432 -11.57347,21.74409c-3.43951,3.71737 -6.73404,5.2409 -8.14237,8.26c-1.56177,3.34803 2.13882,6.3512 0.68061,11.64159c-5.20655,7.87421 -16.0197,15.86444 -25.45274,23.25953c-15.33725,13.76043 -23.22756,12.55727 -29.27398,22.51079c-6.38398,10.5092 -0.37099,22.15884 -6.55092,39.89213c-4.13263,16.7941 -17.88627,54.00951 -17.88627,54.00951c0,0 31.32073,-22.41958 46.62092,-29.69785c27.94932,-14.65009 38.71874,-9.50728 45.55586,-16.17718c2.57764,-9.60396 6.51789,-21.79005 10.93229,-32.68426c4.64251,-11.45716 13.42927,-29.71637 18.27356,-34.36969c4.19749,-1.74243 6.92678,4.69839 8.80721,3.269c2.06351,-1.56855 -1.11195,-9.30029 1.67754,-14.14104c5.2622,3.02185 36.07878,-27.04922 36.07878,-27.04922" />
        <path d="M1034.38368,322.1446l25.2512,15.782l21.39338,17.88627" />
        <path d="M1031.99516,339.51895c0,0 10.18722,7.99283 16.41697,12.08538c6.94383,4.56166 21.39338,15.43129 21.39338,15.43129" />
        <path d="M999.3997,406.63427c-0.24331,19.03304 -37.63294,58.50399 -42.31352,64.21459c-2.01278,3.27786 23.19956,-30.21511 42.24583,-55.12489c9.6223,0.41562 20.16484,-3.69444 14.009,-15.7215c-2.75345,-3.0288 -14.08,0.50946 -13.94131,6.6318z" />
        <path d="M951.87304,478.83787c0,0 -10.04744,12.72337 -15.11987,15.34991c-7.76828,4.02246 -22.40796,-1.57493 -31.16861,3.24674c-10.03957,5.52556 -18.66397,32.95802 -18.66397,32.95802" />
      </svg>
      <p class="mt-6 max-w-2xl font-serif text-lg leading-relaxed text-zinc-400 dark:text-zinc-600 sm:text-xl">
        Data science and machine learning notes from Becky &amp; Nathan <br/> GPU inference, embedding infrastructure, evaluation, and the engineering
        details that don't fit in a README.
      </p>
      <div class="mt-8 flex flex-wrap gap-3">
        <a
          href={path('blog')}
          class="rounded-md bg-brand-600 px-4 py-2 text-sm font-medium text-white transition-colors hover:bg-brand-500"
        >
          Read the blog
        </a>
        <a
          href={path('about')}
          class="rounded-md border border-zinc-700 px-4 py-2 text-sm font-medium text-zinc-300 transition-colors hover:border-zinc-500 hover:text-zinc-100 dark:border-zinc-300 dark:text-zinc-700 dark:hover:border-zinc-500 dark:hover:text-zinc-900"
        >
          About us
        </a>
      </div>
    </div>
  </section>

  <!-- Latest blogs (grid of cards) -->
  {
    latest.length > 0 && (
      <section class="mx-auto max-w-5xl px-5 py-12">
        <div class="mb-6 flex items-baseline justify-between">
          <h2 class="font-serif text-2xl font-semibold tracking-tight text-zinc-100 dark:text-zinc-900">
            Latest
          </h2>
          <a href={path('blog')} class="text-sm text-brand-400 hover:underline dark:text-brand-600">
            {blogCount} {blogCount === 1 ? 'blog' : 'blogs'} →
          </a>
        </div>
        <div class="grid gap-4 sm:grid-cols-2">
          {latest.map((entry) => <BlogCard entry={entry} />)}
        </div>
      </section>
    )
  }

  <!-- Topics teaser -->
  {
    tags.length > 0 && (
      <section class="mx-auto max-w-5xl px-5 py-12">
        <div class="mb-4 flex items-baseline justify-between">
          <h2 class="font-serif text-2xl font-semibold tracking-tight text-zinc-100 dark:text-zinc-900">
            Topics
          </h2>
          <a href={path('tags')} class="text-sm text-brand-400 hover:underline dark:text-brand-600">
            All topics →
          </a>
        </div>
        <div class="flex flex-wrap gap-2">
          {tags.map(({ tag }) => (
            <a href={path(`tags/${tag}`)} class={tagStyle(tag)}>
              #{tag}
            </a>
          ))}
        </div>
      </section>
    )
  }
</Base>

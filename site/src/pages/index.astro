---
import { getCollection } from 'astro:content';
import Base from '../layouts/Base.astro';
import EssayCard from '../components/EssayCard.astro';
import { allTags, tagStyle } from '../lib/tags';
import { path } from '../lib/path';

const all = await getCollection('essays', ({ data }) => import.meta.env.DEV || !data.draft);
const latest = all.sort((a, b) => b.data.pubDate.valueOf() - a.data.pubDate.valueOf()).slice(0, 4);
const tags = allTags(all).slice(0, 8);
const essayCount = all.length;
---

<Base title="The Inkpens" description="Data science and machine learning notes from Nathan & Becky Inkpen.">
  <!-- Editorial hero (text-only, dark-first) -->
  <section class="mx-auto max-w-5xl px-5 pt-20 pb-16 sm:pt-28">
    <div class="max-w-3xl">
      <div class="mb-5 h-1 w-12 rounded-full bg-brand-500"></div>
      <h1 class="font-serif text-5xl font-semibold leading-[1.05] tracking-tight text-zinc-100 sm:text-6xl dark:text-zinc-900">
        The Inkpens.
      </h1>
      <p class="mt-6 max-w-2xl font-serif text-lg leading-relaxed text-zinc-400 dark:text-zinc-600 sm:text-xl">
        Data science and machine learning notes from Nathan &amp; Becky — GPU
        inference, embedding infrastructure, evaluation, and the engineering
        details that don't fit in a README.
      </p>
      <div class="mt-8 flex flex-wrap gap-3">
        <a
          href={path('blog')}
          class="rounded-md bg-brand-600 px-4 py-2 text-sm font-medium text-white transition-colors hover:bg-brand-500"
        >
          Read the blog
        </a>
        <a
          href={path('about')}
          class="rounded-md border border-zinc-700 px-4 py-2 text-sm font-medium text-zinc-300 transition-colors hover:border-zinc-500 hover:text-zinc-100 dark:border-zinc-300 dark:text-zinc-700 dark:hover:border-zinc-500 dark:hover:text-zinc-900"
        >
          About us
        </a>
      </div>
    </div>
  </section>

  <!-- Latest essays (grid of cards) -->
  {
    latest.length > 0 && (
      <section class="mx-auto max-w-5xl px-5 py-12">
        <div class="mb-6 flex items-baseline justify-between">
          <h2 class="font-serif text-2xl font-semibold tracking-tight text-zinc-100 dark:text-zinc-900">
            Latest
          </h2>
          <a href={path('blog')} class="text-sm text-brand-400 hover:underline dark:text-brand-600">
            {essayCount} {essayCount === 1 ? 'essay' : 'essays'} →
          </a>
        </div>
        <div class="grid gap-4 sm:grid-cols-2">
          {latest.map((entry) => <EssayCard entry={entry} />)}
        </div>
      </section>
    )
  }

  <!-- Topics teaser -->
  {
    tags.length > 0 && (
      <section class="mx-auto max-w-5xl px-5 py-12">
        <div class="mb-4 flex items-baseline justify-between">
          <h2 class="font-serif text-2xl font-semibold tracking-tight text-zinc-100 dark:text-zinc-900">
            Topics
          </h2>
          <a href={path('tags')} class="text-sm text-brand-400 hover:underline dark:text-brand-600">
            All topics →
          </a>
        </div>
        <div class="flex flex-wrap gap-2">
          {tags.map(({ tag }) => (
            <a href={path(`tags/${tag}`)} class={tagStyle(tag)}>
              #{tag}
            </a>
          ))}
        </div>
      </section>
    )
  }
</Base>

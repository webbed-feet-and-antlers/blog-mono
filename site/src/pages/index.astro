---
import { getCollection } from 'astro:content';
import Base from '../layouts/Base.astro';
import BlogCard from '../components/BlogCard.astro';
import { allTags, tagStyle } from '../lib/tags';
import { path } from '../lib/path';

const all = await getCollection('blogs', ({ data }) => import.meta.env.DEV || !data.draft);
const latest = all.sort((a, b) => b.data.pubDate.valueOf() - a.data.pubDate.valueOf()).slice(0, 4);
const tags = allTags(all).slice(0, 8);
const blogCount = all.length;
---

<Base title="The Inkpens" description="Data science and machine learning notes from Becky & Nathan Inkpen.">
  <!-- Editorial hero (text-only, dark-first) -->
  <section class="mx-auto max-w-5xl px-5 pt-10 pb-16">
    <div class="max-w-3xl">
      {/* The page heading. The hand-drawn signature below is the visual hero, but
          an SVG with role="img" is exposed to AT as an image, not a heading — so
          this visually-hidden h1 gives the page a proper heading structure. */}
      <h1 class="sr-only">The Inkpens</h1>
      {/* Hand-drawn "The Inkpens" signature as the hero wordmark. Inlined (not <img>)
          so currentColor adapts to light/dark — an <img> can't inherit color. */}
      <svg
        class="h-auto w-full max-w-lg text-zinc-400 dark:text-zinc-500"
        viewBox="436.5 286 700 350"
        fill="none"
        stroke="currentColor"
        stroke-width="8"
        stroke-linecap="round"
        stroke-linejoin="round"
        role="img"
        aria-label="The Inkpens"
      >

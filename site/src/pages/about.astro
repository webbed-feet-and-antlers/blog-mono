---
import Base from '../layouts/Base.astro';
import { path } from '../lib/path';

const people = [
  {
    name: 'Nathan Inkpen',
    role: 'Data Scientist',
    blurb:
      'Works on data, modeling, and evaluation — turning messy real-world inputs into things a model can actually learn from.',
    links: [
      { label: 'GitHub', href: 'https://github.com/nathanp99' },
    ],
  },
  {
    name: 'Becky Inkpen',
    role: 'Machine Learning Engineer',
    blurb:
      'Works on ML infrastructure and serving systems — GPU inference, deployment, and the engineering that takes models from notebook to production.',
    links: [],
  },
];
---

<Base title="About — The Inkpens" description="About Nathan & Becky Inkpen.">
  <section class="mx-auto max-w-3xl px-5 py-12">
    <h1 class="text-3xl font-bold tracking-tight text-zinc-900 dark:text-zinc-100">About</h1>
    <div class="prose prose-zinc mt-6 max-w-none dark:prose-invert">
      <p>
        We're Nathan and Becky Inkpen — a data scientist and a machine learning
        engineer. This is where we write up the systems, experiments, and
        engineering details behind our work.
      </p>
      <p>
        Posts are written in MDX — Markdown plus interactive components — so
        benchmarks, diagrams, and code can be explored rather than just read.
        The source lives on
        <a
          href="https://github.com/webbed-feet-and-antlers/blog-mono"
          target="_blank"
          rel="noopener">GitHub</a
        >.
      </p>
    </div>

    <div class="mt-10 grid gap-4 sm:grid-cols-2">
      {
        people.map((p) => (
          <div class="rounded-xl border border-zinc-200 p-5 dark:border-zinc-800">
            <h2 class="text-base font-semibold text-zinc-900 dark:text-zinc-100">{p.name}</h2>
            <p class="font-mono text-xs text-brand-600 dark:text-brand-400">{p.role}</p>
            <p class="mt-2 text-sm leading-relaxed text-zinc-600 dark:text-zinc-400">{p.blurb}</p>
            {p.links.length > 0 && (
              <div class="mt-3 flex flex-wrap gap-3">
                {p.links.map((l) => (
                  <a
                    href={l.href}
                    target="_blank"
                    rel="noopener"
                    class="text-xs text-brand-600 hover:underline dark:text-brand-400"
                  >
                    {l.label} →
                  </a>
                ))}
              </div>
            )}
          </div>
        ))
      }
    </div>

    <p class="mt-8 text-center">
      <a
        href={path('blog')}
        class="text-sm font-medium text-brand-600 hover:underline dark:text-brand-400"
      >
        Read the blog →
      </a>
    </p>
  </section>
</Base>

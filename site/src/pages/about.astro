---
import Base from '../layouts/Base.astro';
import { path } from '../lib/path';
import { SOCIALS } from '../lib/socials';
import SocialIcon from '../components/SocialIcon.astro';

const people = [
  {
    name: 'Becky Inkpen',
    role: 'Machine Learning Engineer',
    blurb:
    'Works on ML infrastructure and serving systems. Loves writing and deploying production-ready code, and reluctantly makes Nathan\'s messy notebooks ready for production.',
    links: [
      { label: 'GitHub', href: 'https://github.com/WritingImplement' },
      { label: 'LinkedIn', href: 'https://www.linkedin.com/in/becky-i-643539274/' }
    ],
  },
  {
    name: 'Nathan Inkpen',
    role: 'Data Scientist',
    blurb:
      'Works on data, modeling, and evaluation. Turns messy real-world inputs into something a model can actually learn from.',
    links: [
      { label: 'GitHub', href: 'https://github.com/nathanp99' },
      { label: 'LinkedIn', href: 'https://www.linkedin.com/in/nathan-pride-78aab5156/' }
    ],
  },
];
---

<Base title="About — The Inkpens" description="About Becky & Nathan Inkpen.">
  <section class="mx-auto max-w-3xl px-5 py-12">
    <h1 class="font-serif text-3xl font-semibold tracking-tight text-zinc-100 dark:text-zinc-900">
      About
    </h1>
    <div class="prose prose-invert prose-zinc mt-6 max-w-none dark:prose-zinc dark:prose-none">
      <p>
        We're Becky and Nathan Inkpen, husband and wife data scientist and a machine learning
        engineer. This is where we write up the systems, experiments, and
        engineering details behind our work.
      </p>
      <p>
        You can see the source code for this site and all the essays and blogs on our GitHub.
        Posts are in the essays directory, written in MDX, allowing for interactive components.
        Each experiment has it's own directory, with code, data, and results.
        The source lives on
        <a
          href="https://github.com/webbed-feet-and-antlers/blog-mono"
          target="_blank"
          rel="noopener">GitHub</a
        >.
      </p>
    </div>

    <div class="mt-10 grid gap-4 sm:grid-cols-2">
      {
        people.map((p) => (
          <div class="rounded-xl border border-zinc-800 bg-zinc-900/40 p-5 dark:border-zinc-200 dark:bg-white">
            <h2 class="font-serif text-lg font-semibold text-zinc-100 dark:text-zinc-900">{p.name}</h2>
            <p class="font-mono text-xs text-brand-400 dark:text-brand-600">{p.role}</p>
            <p class="mt-2 text-sm leading-relaxed text-zinc-400 dark:text-zinc-600">{p.blurb}</p>
            {p.links.length > 0 && (
              <div class="mt-3 flex flex-wrap gap-3">
                {p.links.map((l) => (
                  <a
                    href={l.href}
                    target="_blank"
                    rel="noopener"
                    class="text-xs text-brand-400 hover:underline dark:text-brand-600"
                  >
                    {l.label} →
                  </a>
                ))}
              </div>
            )}
          </div>
        ))
      }
    </div>

    <p class="mt-8 text-center">
      <a
        href={path('blog')}
        class="text-sm font-medium text-brand-400 hover:underline dark:text-brand-600"
      >
        Read the blog →
      </a>
    </p>

    <div class="mt-12 rounded-xl border border-zinc-800 bg-zinc-900/40 p-5 dark:border-zinc-200 dark:bg-white">
      <h2 class="font-serif text-lg font-semibold text-zinc-100 dark:text-zinc-900">Contact</h2>
      <p class="mt-1 text-sm text-zinc-400 dark:text-zinc-600">
        Questions, corrections, or just want to chat about anything? Email us, we'd love to hear from you!
        We are also open to any collaborations or consulting opportunities, so feel free to reach out if you have an idea.
      </p>
      <a
        href="mailto:thetwoinkpens@gmail.com"
        class="mt-3 inline-flex items-center gap-2 rounded-md bg-brand-600 px-4 py-2 text-sm font-medium text-white transition-colors hover:bg-brand-500"
      >
        <svg class="h-4 w-4" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2" stroke-linecap="round" stroke-linejoin="round">
          <rect x="2" y="4" width="20" height="16" rx="2" />
          <path d="m22 7-8.97 5.7a1.94 1.94 0 0 1-2.06 0L2 7" />
        </svg>
        thetwoinkpens@gmail.com
      </a>
    </div>

    <div class="mt-6 rounded-xl border border-zinc-800 bg-zinc-900/40 p-5 dark:border-zinc-200 dark:bg-white">
      <h2 class="font-serif text-lg font-semibold text-zinc-100 dark:text-zinc-900">Follow</h2>
      <p class="mt-1 text-sm text-zinc-400 dark:text-zinc-600">
        We syndicate posts across these platforms (POSSE). Pick wherever you read.
      </p>
      <ul class="mt-3 divide-y divide-zinc-800 dark:divide-zinc-200">
        {
          SOCIALS.map((s) => (
            <li>
              <a
                href={s.href}
                target="_blank"
                rel="noopener"
                class="group flex items-center gap-3 py-2.5"
              >
                <span class="text-zinc-500 transition-colors group-hover:text-brand-400 dark:group-hover:text-brand-600">
                  <SocialIcon name={s.icon} />
                </span>
                <span class="text-sm font-medium text-zinc-200 dark:text-zinc-800">{s.label}</span>
                <span class="ml-auto font-mono text-xs text-zinc-500">{s.handle}</span>
              </a>
            </li>
          ))
        }
      </ul>
    </div>
  </section>
</Base>

---
import Base from '../layouts/Base.astro';
---

<Base title="About — blog-mono" description="About this site.">
  <section class="mx-auto max-w-3xl px-5 py-12">
    <h1 class="text-3xl font-bold tracking-tight text-zinc-900 dark:text-zinc-100">About</h1>
    <div class="prose prose-zinc mt-6 max-w-none dark:prose-invert">
      <p>
        blog-mono is a working notebook for systems, ML infrastructure, and the
        engineering details that don't fit in a README.
      </p>
      <p>
        Posts here are written in MDX — Markdown plus interactive components — so
        benchmarks, diagrams, and code can be explored rather than just read.
        The source lives on
        <a
          href="https://github.com/webbed-feet-and-antlers/blog-mono"
          target="_blank"
          rel="noopener">GitHub</a
        >.
      </p>
      <p class="text-zinc-500 dark:text-zinc-400">
        <!-- Replace this placeholder with your real bio and contact links. -->
        <em>This is a placeholder — edit <code>src/pages/about.astro</code>.</em>
      </p>
    </div>
  </section>
</Base>

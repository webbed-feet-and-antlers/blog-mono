---
import { getCollection } from 'astro:content';
import Base from '../../layouts/Base.astro';
import EssayCard from '../../components/EssayCard.astro';

const all = await getCollection('essays', ({ data }) => import.meta.env.DEV || !data.draft);
const essays = all.sort((a, b) => b.data.pubDate.valueOf() - a.data.pubDate.valueOf());
---

<Base title="Blog — The Inkpens" description="Essays on data science, machine learning, and systems.">
  <section class="mx-auto max-w-3xl px-5 py-12">
    <div class="mb-10">
      <h1 class="text-2xl font-bold tracking-tight text-zinc-900 dark:text-zinc-100">Blog</h1>
      <p class="mt-2 text-sm text-zinc-600 dark:text-zinc-400">
        Notes and write-ups from our work in data science and ML engineering.
      </p>
    </div>
    <div class="divide-y divide-zinc-200 dark:divide-zinc-800">
      {essays.map((entry) => <EssayCard entry={entry} />)}
    </div>
    {
      essays.length === 0 && (
        <p class="py-12 text-center text-sm text-zinc-500 dark:text-zinc-500">
          No essays published yet.
        </p>
      )
    }
  </section>
</Base>

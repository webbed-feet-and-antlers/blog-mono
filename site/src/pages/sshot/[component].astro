---
// Screenshot harness: renders a single React island in a chromeless page so
// scripts/lib/component-shot.mjs can screenshot it for cross-posting.
// Not linked from the site; reached directly at /sshot/<ComponentName>.
// To add a screenshot-able component, add an import + a branch below.
import BinPacker from '../../components/react/BinPacker';
import Chart from '../../components/react/Chart';

export function getStaticPaths() {
  // One static page per screenshot-able component.
  return [{ params: { component: 'BinPacker' } }, { params: { component: 'Chart' } }];
}

const { component } = Astro.params;
---

<html lang="en">
  <head>
    <meta charset="utf-8" />
    <meta name="robots" content="noindex" />
    <style>
      /* Reset everything so the screenshot is just the component. */
      * { margin: 0; padding: 0; box-sizing: border-box; }
      html, body {
        background: transparent;
        font-family: ui-sans-serif, system-ui, -apple-system, sans-serif;
        color: #18181b; /* zinc-900, matching the site */
      }
      .shot-wrap { padding: 16px; width: 800px; }
      .unknown { padding: 16px; color: #dc2626; }
    </style>
  </head>
  <body>
    {/* Astro's compiler needs a direct import reference for client:only, so we
        branch on the component name explicitly rather than looking it up in a map. */}
    <div class="shot-wrap" data-shot>
      {component === 'BinPacker' && <BinPacker client:only="react" />}
      {
        component === 'Chart' && (
          <Chart
            client:only="react"
            data={[
              { batch: '8', tokens: 7800 },
              { batch: '16', tokens: 15200 },
              { batch: '32', tokens: 28600 },
              { batch: '64', tokens: 41000 },
            ]}
            xKey="batch"
            series={[{ dataKey: 'tokens', name: 'tokens/sec', color: '#1e5cf5' }]}
            height={300}
            yLabel="tokens/sec"
          />
        )
      }
      {
        component !== 'BinPacker' && component !== 'Chart' && (
          <div class="unknown">
            Unknown component: {component}. Add an import + branch in
            <code>src/pages/sshot/[component].astro</code>.
          </div>
        )
      }
    </div>
  </body>
</html>

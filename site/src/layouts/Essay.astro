---
import Base from './Base.astro';
import type { CollectionEntry } from 'astro:content';

interface Props {
  entry: CollectionEntry<'essays'>;
  readingTime?: number;
}
const { entry, readingTime } = Astro.props;
const { title, description, pubDate, updatedDate, tags, syndication } = entry.data;
const dateStr = pubDate.toLocaleDateString('en-US', {
  year: 'numeric',
  month: 'long',
  day: 'numeric',
});
const updatedStr = updatedDate
  ? updatedDate.toLocaleDateString('en-US', { year: 'numeric', month: 'long', day: 'numeric' })
  : null;

// Build the "Also published on" list from frontmatter syndication IDs.
// POSSE: post on your own site (canonical), syndicate everywhere else.
const synd = syndication ?? {};
const blueskyHandle = import.meta.env.PUBLIC_BLUESKY_HANDLE;
type SyndLink = { label: string; href: string };
const syndLinks: SyndLink[] = [
  synd.devto && { label: 'dev.to', href: `https://dev.to` },
  synd.bluesky && {
    label: 'Bluesky',
    href: blueskyHandle
      ? `https://bsky.app/profile/${blueskyHandle}/post/${synd.bluesky.split('/').pop()}`
      : 'https://bsky.app',
  },
  synd.mastodon && { label: 'Mastodon', href: import.meta.env.PUBLIC_MASTODON_INSTANCE ?? '#' },
  synd.linkedin && { label: 'LinkedIn', href: 'https://www.linkedin.com' },
  synd.buffer && { label: 'X', href: 'https://x.com' },
  synd.medium && { label: 'Medium', href: `https://medium.com/p/${synd.medium}` },
].filter((l): l is SyndLink => l !== undefined && l !== null && l !== 0 && l !== '');
---

<Base title={title} description={description}>
  <article class="mx-auto max-w-3xl px-5 py-12">
    <header class="mb-10 border-b border-zinc-200 pb-8 dark:border-zinc-800">
      <h1
        class="text-3xl font-bold tracking-tight text-zinc-900 sm:text-4xl dark:text-zinc-100"
      >
        {title}
      </h1>
      <p class="mt-3 text-base text-zinc-600 dark:text-zinc-400">{description}</p>
      <div
        class="mt-4 flex flex-wrap items-center gap-x-3 gap-y-1 text-sm text-zinc-500 dark:text-zinc-500"
      >
        <time datetime={pubDate.toISOString()}>{dateStr}</time>
        {readingTime && <><span aria-hidden="true">·</span><span>{readingTime} min read</span></>}
        {
          updatedStr && (
            <>
              <span aria-hidden="true">·</span>
              <span>updated {updatedStr}</span>
            </>
          )
        }
      </div>
      {
        tags.length > 0 && (
          <div class="mt-3 flex flex-wrap gap-1.5">
            {tags.map((t: string) => (
              <span class="rounded-full bg-zinc-100 px-2 py-0.5 font-mono text-[11px] text-zinc-500 dark:bg-zinc-900 dark:text-zinc-400">
                #{t}
              </span>
            ))}
          </div>
        )
      }
    </header>

    <div
      class="prose prose-zinc max-w-none prose-headings:scroll-mt-20 prose-headings:font-semibold prose-a:text-brand-600 prose-a:no-underline hover:prose-a:underline prose-pre:bg-zinc-950 prose-pre:p-4 prose-img:rounded-lg dark:prose-invert dark:prose-a:text-brand-400"
    >
      <slot />
    </div>

    {
      syndLinks.length > 0 && (
        <footer class="mt-12 border-t border-zinc-200 pt-6 dark:border-zinc-800">
          <p class="font-mono text-[11px] uppercase tracking-wide text-zinc-400 dark:text-zinc-600">
            Also published on
          </p>
          <div class="mt-2 flex flex-wrap gap-x-4 gap-y-1 text-sm">
            {syndLinks.map((l: { label: string; href: string }) => (
              <a
                href={l.href}
                target="_blank"
                rel="noopener nofollow"
                class="font-medium text-brand-600 hover:underline dark:text-brand-400"
              >
                {l.label} ↗
              </a>
            ))}
          </div>
        </footer>
      )
    }
  </article>
</Base>

---
import '../styles/global.css';
import Header from '../components/Header.astro';
import Footer from '../components/Footer.astro';
import { path } from '../lib/path';

interface Props {
  title: string;
  description?: string;
  /** OG image path relative to base, e.g. "/og/embeddings.png" */
  image?: string;
  /** "article" for blog posts, "website" (default) everywhere else. */
  ogType?: 'website' | 'article';
}

const {
  title,
  description = 'Data science and machine learning notes from Nathan & Becky Inkpen.',
  image,
  ogType = 'website',
} = Astro.props;
const canonical = new URL(Astro.url.pathname, Astro.site).toString();
const ogImage = image ? new URL(image, Astro.site).toString() : undefined;
// Dimension tags only apply to the auto-generated 1200×630 cards — custom
// heroImage overrides can be any size.
const isAutoCard = Boolean(ogImage && image?.startsWith(path('og/')));

// Umami analytics — cookieless. Set UMAMI_WEBSITE_ID in .env (local) or as a
// GitHub Actions var (production) to enable; leave unset to disable (e.g. dev).
// UMAMI_HOST must match the region of the website in Umami Cloud: EU accounts
// (dashboard URL contains /analytics/eu/) use https://eu.umami.is — sending to
// the cloud.umami.is ingest records into the wrong region and the EU dashboard
// stays empty. Override to your own origin (like https://stats.inkpens.tech)
// if you self-host later.
const umamiWebsiteId = import.meta.env.UMAMI_WEBSITE_ID;
const umamiHost = (import.meta.env.UMAMI_HOST || 'https://eu.umami.is').replace(/\/$/, '');
---

<!doctype html>
<html lang="en">
  <head>
    <meta charset="UTF-8" />
    <meta name="viewport" content="width=device-width, initial-scale=1.0" />
    <link rel="icon" type="image/svg+xml" href={path('favicon.svg')} />
    <meta name="generator" content={Astro.generator} />

    {/*
      Content-Security-Policy. GitHub Pages can't set HTTP headers, so this is a
      <meta> tag (HTML documents only). Astro bundles the islands + theme toggle
      as INLINE scripts, so script-src can't drop 'unsafe-inline' without breaking
      hydration — that gap is covered by the build-time scanner (scripts/scan-components.mjs)
      which catches injected/dynamic scripts before they ship. The CSP's real teeth here:
        - connect-src 'self'  → blocks fetch/XHR/WebSocket to any external domain (exfiltration)
        - object-src 'none'   → no plugins/Flash
        - base-uri 'self'     → no <base> hijack
        - form-action 'self'  → no off-site form submission
      External allowlist:
        - script-src/connect-src: cloud.umami.is + eu.umami.is (the analytics
          script + beacon, US and EU regions)
        - style-src: Google Fonts (CSS), jsDelivr (KaTeX CSS)
        - font-src: Google Fonts (font files)
    */}
    <meta
      http-equiv="Content-Security-Policy"
      content="default-src 'self'; script-src 'self' 'unsafe-inline' https://cloud.umami.is https://eu.umami.is; style-src 'self' 'unsafe-inline' https://fonts.googleapis.com https://cdn.jsdelivr.net; font-src 'self' https://fonts.gstatic.com; img-src 'self' data: https:; connect-src 'self' https://cloud.umami.is https://eu.umami.is; object-src 'none'; base-uri 'self'; form-action 'self'"
    />

    {/*
      Umami analytics (https://umami.is) — cookieless, no consent banner needed.
      Env-gated: only renders when UMAMI_WEBSITE_ID is set, so the dev server and
      any build without the ID ship zero analytics. is:inline keeps the tag literal
      (Astro would otherwise bundle/break it). UMAMI_HOST defaults to the EU cloud
      ingest; override to a self-hosted origin if you move off cloud.
      data-host-url is load-bearing: without it the tracker sends to
      https://gateway.umami.is/api/send, which does NOT route EU-region
      websites — beacons vanish even though the script loads fine.
    */}
    {umamiWebsiteId && (
      <script
        defer
        is:inline
        src={`${umamiHost}/script.js`}
        data-website-id={umamiWebsiteId}
        data-host-url={umamiHost}
        data-domains="inkpens.tech"
      />
    )}

    <title>{title}</title>
    <meta name="description" content={description} />
    <link rel="canonical" href={canonical} />

    <!-- RSS -->
    <link rel="alternate" type="application/rss+xml" title="The Inkpens" href={path('rss.xml')} />

    <!-- KaTeX styles for $$math$$ rendered by rehype-katex -->
    <link
      rel="stylesheet"
      href="https://cdn.jsdelivr.net/npm/katex@0.16.22/dist/katex.min.css"
      crossorigin="anonymous"
    />

    <!-- Open Graph / Twitter -->
    <meta property="og:site_name" content="The Inkpens" />
    <meta property="og:type" content={ogType} />
    <meta property="og:title" content={title} />
    <meta property="og:description" content={description} />
    <meta property="og:url" content={canonical} />
    {ogImage && <meta property="og:image" content={ogImage} />}
    {ogImage && <meta property="og:image:alt" content={`${title} — preview card`} />}
    {isAutoCard && <meta property="og:image:width" content="1200" />}
    {isAutoCard && <meta property="og:image:height" content="630" />}
    <meta name="twitter:card" content={ogImage ? 'summary_large_image' : 'summary'} />
    <meta name="twitter:title" content={title} />
    <meta name="twitter:description" content={description} />
    {ogImage && <meta name="twitter:image" content={ogImage} />}

    <!-- Fonts: Inter (sans/UI), Fraunces (serif headlines), JetBrains Mono (code). -->
    <link rel="preconnect" href="https://fonts.googleapis.com" />
    <link rel="preconnect" href="https://fonts.gstatic.com" crossorigin />
    <link
      href="https://fonts.googleapis.com/css2?family=Fraunces:opsz,wght@9..144,400;9..144,500;9..144,600;9..144,700&family=Inter:wght@400;500;600;700&family=JetBrains+Mono:wght@400;500&display=swap"
      rel="stylesheet"
    />
  </head>
  <body
    class="min-h-screen bg-zinc-950 font-sans text-zinc-300 antialiased dark:bg-white dark:text-zinc-700 [--wm:var(--wm-dark)] dark:[--wm:var(--wm-light)]"
    style={`--wm-dark: url('${path('inkpen-watermark-dark.svg')}'); --wm-light: url('${path('inkpen-watermark-light.svg')}')`}
  >
    {/* Skip link: first focusable element, hidden until focused. Lets keyboard
        users bypass the header/nav and jump straight to page content. */}
    <a
      href="#main"
      class="sr-only focus:not-sr-only focus:absolute focus:left-4 focus:top-4 focus:z-50 focus:rounded-md focus:bg-brand-600 focus:px-4 focus:py-2 focus:text-white"
    >
      Skip to content
    </a>
    <Header />
    <main id="main" tabindex="-1">
      <slot />
    </main>
    <Footer />
  </body>
</html>

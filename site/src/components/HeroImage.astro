---
// The hero image for a blog: a per-post custom image (entry.data.heroImage)
// wins, otherwise the auto-generated title card at /og/<slug>.png. Used both as
// the in-page banner atop a blog and as the thumbnail on the blog index, so
// the resolution logic + markup lives in one place.
import type { CollectionEntry } from 'astro:content';
import { path } from '../lib/path';

interface Props {
  entry: CollectionEntry<'blogs'>;
  /** Render at thumbnail size (for the blog index) vs full banner. */
  size?: 'full' | 'thumb';
}
const { entry, size = 'full' } = Astro.props;
const slug = entry.id.replace(/\.(md|mdx)$/, '');
const src = entry.data.heroImage ?? path(`og/${slug}.png`);
const isThumb = size === 'thumb';
---

<img
  src={src}
  alt={entry.data.title}
  width={1200}
  height={630}
  loading={isThumb ? 'lazy' : 'eager'}
  class:list={[
    'w-full mb-4 rounded-lg border border-zinc-800 object-cover dark:border-zinc-200',
    isThumb ? 'aspect-[1200/630]' : 'shadow-lg',
  ]}
/>

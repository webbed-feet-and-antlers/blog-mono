---
import type { CollectionEntry } from 'astro:content';
import { path } from '../lib/path';
import { tagStyle } from '../lib/tags';
import HeroImage from './HeroImage.astro';

interface Props {
  entry: CollectionEntry<'essays'>;
}
const { entry } = Astro.props;
const { title, description, pubDate, tags } = entry.data;
const href = path('blog/' + entry.id.replace(/\.(md|mdx)$/, ''));
const dateStr = pubDate.toLocaleDateString('en-US', {
  year: 'numeric',
  month: 'short',
  day: 'numeric',
});
---

<article class="group h-full">
  <a
    href={href}
    class="flex h-full flex-col gap-3 rounded-xl border border-zinc-800 bg-zinc-900/40 p-5 transition-colors hover:border-brand-500/50 hover:bg-zinc-900 dark:border-zinc-200 dark:bg-white dark:hover:border-brand-500/50 dark:hover:bg-zinc-50"
  >
    <HeroImage entry={entry} size="thumb" />
    <time
      datetime={pubDate.toISOString()}
      class="font-mono text-[11px] uppercase tracking-wide text-zinc-500 dark:text-zinc-500"
    >
      {dateStr}
    </time>
    <h2 class="font-serif text-xl font-semibold leading-snug text-zinc-100 transition-colors group-hover:text-brand-300 dark:text-zinc-900 dark:group-hover:text-brand-700">
      {title}
    </h2>
    <p class="grow text-sm leading-relaxed text-zinc-400 dark:text-zinc-600">{description}</p>
    {
      tags.length > 0 && (
        <div class="mt-1 flex flex-wrap gap-1.5">
          {tags.map((t: string) => (
            <span class={tagStyle(t)}>#{t}</span>
          ))}
        </div>
      )
    }
  </a>
</article>

---
import { path } from '../lib/path';
const year = new Date().getFullYear();
---

<footer class="mt-20 border-t border-zinc-800/70 dark:border-zinc-200/70">
  <div
    class="mx-auto flex max-w-5xl flex-col items-center justify-between gap-2 px-5 py-8 text-sm text-zinc-500 dark:text-zinc-500 sm:flex-row"
  >
    <p>© {year} The Inkpens</p>
    <div class="flex items-center gap-4">
      <a href={path('rss.xml')} class="hover:text-zinc-100 dark:hover:text-zinc-900">RSS</a>
      <a
        href="https://github.com/webbed-feet-and-antlers/blog-mono"
        target="_blank"
        rel="noopener"
        class="hover:text-zinc-100 dark:hover:text-zinc-900">GitHub</a
      >
    </div>
  </div>
</footer>

---
/**
 * Brand glyph for a social platform. All icons are 24x24, use currentColor, and
 * are drawn as either filled (X, Bluesky, Medium, DEV, Substack) or stroked
 * (Mastodon) so they inherit the surrounding text color + hover state.
 */
interface Props {
  name: 'devto' | 'medium' | 'substack' | 'bluesky' | 'mastodon' | 'x' | 'rss';
  class?: string;
}
const { name, class: className = 'h-4 w-4' } = Astro.props;
---


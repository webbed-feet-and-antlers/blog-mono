# POSSE syndication secrets — copy to .env for local dry-runs, or set these as
# GitHub repository secrets under the `syndication` environment for CI.
# Every platform degrades gracefully: leave a secret unset and the script skips it.

# Canonical origin of your own site (the canonical URL blogs point back to).
SITE_URL=https://webbed-feet-and-antlers.github.io/blog-mono

# Public origin where OG images are served, so Buffer can fetch them for X and
# LinkedIn posts. The site prerenders one image per blog at /og/<slug>.png at
# build time (src/pages/og/[slug].png.ts), so set this to your deployed origin.
# Buffer fetches the image by URL at publish time; unset = text-only X/LinkedIn.
PUBLIC_OG_BASE_URL=

# --- dev.to (free, https://developers.forem.com/api/v1) ---
# Settings → Extensions → DEV Community API Keys
DEV_TO_API_KEY=

# --- Bluesky (free, AT Protocol) ---
# Settings → App Passwords (NOT your account password)
BLUESKY_IDENTIFIER=
BLUESKY_APP_PASSWORD=

# --- Mastodon (free, per-instance) ---
# Your instance origin, e.g. https://mastodon.social
# Token: instance → Development → New application (scopes: write:statuses write:media)
MASTODON_INSTANCE=
MASTODON_TOKEN=

# --- X / Twitter + LinkedIn via Buffer (free Buffer plan covers both) ---
# Connect the accounts in Buffer, then publish.buffer.com/settings/api → personal
# API key. The canonical link goes in the LinkedIn post body (Buffer's
# first-comment is paid-plan-only, so we don't rely on it).
BUFFER_API_KEY=
# The channel id of your connected X account inside Buffer
BUFFER_X_CHANNEL_ID=
# The channel id of your connected LinkedIn account inside Buffer
BUFFER_LINKEDIN_CHANNEL_ID=

# --- Medium, Substack, LinkedIn Articles, Indie Hackers (ASSISTED DRAFTS) ---
# None of these have a posting API in 2026 (Medium's closed to new
# integrations Jan 2025; Substack's is read-only; the LinkedIn Article and
# Indie Hackers formats are UI-only). Locally they run in assisted mode:
#   task posse:login -- substack|medium|linkedin|indiehackers
# captures a browser session under .syndication-output/sessions/ (gitignored,
# never in CI), after which syndication creates DRAFTS via each platform's
# own editor — you review and click Publish, then
#   task posse:confirm -- <slug> <platform> <public-url>
# records it. No session (or in CI) = manual paste package as before.
# SUBSTACK_DRAFT_MODE=teaser  # default; SEO-safe (Substack has no canonical URLs)
SUBSTACK_DRAFT_MODE=
# IH_DRAFT_MODE=teaser       # same idea for Indie Hackers (no canonical URLs)
IH_DRAFT_MODE=
# Substack publication slug (used for editor URLs and the draft API origin).
SUBSTACK_PUB=theinkpens

# --- Site analytics (Umami — cookieless, no consent banner) ---
# Cloud Hobby tier is free (https://umami.is). Create a website there, copy its
# ID, and set it here to enable pageview tracking. Leave UNSET to disable
# (e.g. local dev ships zero analytics — the script tag is env-gated).
UMAMI_WEBSITE_ID=
# Optional: override the Umami script/beacon host. Defaults to the cloud CDN.
# Set to your own origin (e.g. https://stats.inkpens.tech) if you self-host.
UMAMI_HOST=https://cloud.umami.is

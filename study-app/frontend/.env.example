# Clerk publishable key (frontend). Create a dev app at dashboard.clerk.com
# and copy the publishable key (pk_test_…).
VITE_CLERK_PUBLISHABLE_KEY=

# Umami analytics (optional — unset ships zero analytics). Create a website
# in the EU cloud dashboard (eu.umami.is), copy its ID, and set it here for
# local verification only; production gets it via the Docker build-arg
# (repo variable STUDY_UMAMI_WEBSITE_ID).
VITE_UMAMI_WEBSITE_ID=
VITE_UMAMI_HOST=https://eu.umami.is

# LLM config via OpenRouter — one key works across all providers.
# Get a key at https://openrouter.ai/keys
OPENROUTER_API_KEY=

# Model slug. Swap to any model OpenRouter serves, e.g.:
#   deepseek/deepseek-v4-flash        (cheap + fast, default for the POC)
#   anthropic/claude-sonnet-4
#   openai/gpt-4o
#   google/gemini-flash-1.5
OPENROUTER_MODEL=deepseek/deepseek-v4-flash

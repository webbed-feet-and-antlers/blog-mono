# LLM config via OpenRouter — one key works across all providers.
# Get a key at https://openrouter.ai/keys
#
# This key powers BOTH the LLM (chat completions) AND audio transcription
# (qwen3-asr-1.7b via OpenRouter's /audio/transcriptions endpoint).
OPENROUTER_API_KEY=

# Model slug for LLM generation. Swap to any model OpenRouter serves, e.g.:
#   deepseek/deepseek-v4-flash-0731        (cheap + fast, default for the POC)
#   anthropic/claude-sonnet-4
#   openai/gpt-4o
#   google/gemini-flash-1.5
OPENROUTER_MODEL=deepseek/deepseek-v4-flash-0731

# Auth — Clerk (multi-user login). Create a dev app at dashboard.clerk.com,
# enable Email/Password sign-in, add http://localhost:5173 to the allowed
# origins, then paste both keys:
CLERK_SECRET_KEY=

# Production deployment — study.inkpens.tech (defaults are the dev origins):
# CORS_ORIGINS=["https://study.inkpens.tech"]
# CLERK_AUTHORIZED_PARTIES=["https://study.inkpens.tech"]

# Database — leave UNSET for local SQLite at DB_PATH (zero setup). Set to a
# Postgres URL for the Postgres dialect (asyncpg injected automatically):
# production uses Supabase's transaction pooler (port 6543).
# DATABASE_URL=postgresql://postgres.[ref]:[password]@aws-0-eu-west-2.pooler.supabase.com:6543/postgres

# Activity-ledger retention cap. Default 5000 rows (keeps SQLite lean); set 0
# on Postgres to disable pruning — the ledger is the agent's behavioral
# memory and storage is cheap there.
# ACTIVITY_LEDGER_MAX_ROWS=5000
